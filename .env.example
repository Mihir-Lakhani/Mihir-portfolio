# Keep real values in the server environment. Never expose GEMINI_API_KEY to JavaScript.
GEMINI_API_KEY=
# Set only in deployed environments. Keep the actual hostname server-side.
PUBLIC_ORIGIN=
# Local hybrid is the default. Keep this File Search store value only if you
# explicitly switch RAG_RETRIEVAL_MODE to gemini_file_search.
RAG_GEMINI_FILE_SEARCH_STORE_ID=
RAG_GEMINI_MODEL=gemini-3.5-flash-lite
RAG_RETRIEVAL_MODE=local_hybrid
RAG_LOCAL_INDEX_DIR=instance/rag_local_index
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
RAG_LOCAL_TOP_K=6
RAG_MAX_RESULTS=5
RAG_MAX_QUESTION_CHARACTERS=2000
RAG_MAX_ANSWER_TOKENS=350
RAG_MAX_CONVERSATION_TURNS=6
RAG_MAX_CONVERSATION_CHARACTERS=2400
RAG_ROUTER_MAX_OUTPUT_TOKENS=180
# The browser receives a fresh Gemini final-reply session after each page reload.
RAG_STATEFUL_CONVERSATIONS=true
RAG_CONVERSATION_SESSION_TTL_SECONDS=1200
# Development is uncapped; production enables these defaults unless explicitly overridden.
RAG_ENV=development
# RAG_ENABLE_RATE_LIMITS=true
RAG_RATE_LIMIT_PER_MINUTE=12
RAG_GLOBAL_RATE_LIMIT_PER_MINUTE=60
RAG_GEMINI_TIMEOUT_SECONDS=60
RAG_GEMINI_MAX_RETRIES=0
# Local development only. Leave empty in deployed environments.
RAG_LOCAL_DIAGNOSTICS_PATH=
